{
  "name": "dsh-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin monorepo for DeepSeek Harness: npm-installable bundles plus a format-1 plugin market index.",
  "license": "MIT",
  "author": "layman-hu",
  "type": "module",
  "homepage": "https://github.com/layman-hu/dsh-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layman-hu/dsh-plugins.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test",
    "test:index-check": "node --test scripts/index-check.test.mjs",
    "sentinel": "node scripts/sentinel.mjs",
    "index": "node scripts/make-index.mjs",
    "index:check": "node scripts/make-index.mjs --check",
    "validate": "node scripts/validate-index.mjs",
    "check": "npm run sentinel && npm test && npm run validate && npm run index:check"
  },
  "dsh": {
